<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <AssemblyName>omsi-script-language-server</AssemblyName>
        <RootNamespace>OMSIScript.LanguageServer</RootNamespace>
        <PublishAot>true</PublishAot>
        <InvariantGlobalization>true</InvariantGlobalization>
        <UseSystemResourceKeys>false</UseSystemResourceKeys>
        <OptimizationPreference>Speed</OptimizationPreference>
        <StackTraceSupport>false</StackTraceSupport>
        <EventSourceSupport>false</EventSourceSupport>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <ServerGarbageCollector>false</ServerGarbageCollector>
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\OMSIScript.Core\OMSIScript.Core.csproj" />
    </ItemGroup>

</Project>
